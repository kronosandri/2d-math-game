  m_Script: {fileID: 11500000, guid: 397ce4e5d5836d34f83667104a81574a, type: 3}
  m_Name: QuadraticFormula
  m_EditorClassIdentifier: Assembly-CSharp::FormulaData
  formulaTitle: Quadratic Formula
  equationText: "x = (-b \xB1 \u221A(b\xB2 - 4ac)) / 2a"
  description: "Used to find the two possible solutions or root intercepts of a quadratic
    equation (ax\xB2 + bx + c = 0). Because of the plus-minus (\xB1) sign, solving
    this provides two separate numerical coordinates. Useful for locking devices
    that require a dual-input numeric combination."
