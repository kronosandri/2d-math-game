  m_Script: {fileID: 11500000, guid: 397ce4e5d5836d34f83667104a81574a, type: 3}
  m_Name: AreaOfATriangle
  m_EditorClassIdentifier: Assembly-CSharp::FormulaData
  formulaTitle: Area of a Triangle
  equationText: "Area = (Base \xD7 Height) / 2"
  description: Calculates the total flat space bounded within any three-sided shape.
    Useful for tile puzzles or pressure plates where a triangular floor panel requires
    exactly half the capacity of a full rectangular zone to balance a weight switch.
  isUnlocked: 0
